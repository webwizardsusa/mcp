APP_ENV=local
FRONTEND_URL=http://localhost:5173
DATABASE_URL=postgresql+psycopg2://username:password@localhost:5432/ai_mcp
JWT_SECRET_KEY=local-dev-only-change-me-32chars-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=refresh_token
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=lax

# AI — flip only AI_PROVIDER; keep both keys/models as needed
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# To use Gemini instead:
# AI_PROVIDER=gemini
# (set GEMINI_API_KEY; model vars above can stay)

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_AUTH_PER_MINUTE=20
# Required when APP_ENV != local (Docker/production). Optional for local single-process.
RATE_LIMIT_REDIS_URL=
