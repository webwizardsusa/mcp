APP_ENV=production
POSTGRES_USER=aiproduct
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ai_mcp
JWT_SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-chars
FRONTEND_URL=http://localhost
REFRESH_COOKIE_SECURE=true

# AI — flip only AI_PROVIDER; keep both keys/models as needed
AI_PROVIDER=openai
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
# To use Gemini instead:
# AI_PROVIDER=gemini
# (set GEMINI_API_KEY; model vars above can stay)

RATE_LIMIT_ENABLED=true
RATE_LIMIT_CHAT_PER_MINUTE=20
RATE_LIMIT_REDIS_URL=redis://redis:6379/0
WEB_PORT=80
IMAGE_TAG=latest
